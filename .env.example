# Names only — never commit a value. Server-side variables (no NEXT_PUBLIC_ prefix for any secret).
# Publications OAuth (Lot 4.3 P11-a): see docs/publications-oauth.md.
PUBLICATIONS_OAUTH_BASE_URL=
META_APP_ID=
META_APP_SECRET=
# true only if your role on the client Pages comes from a Business Manager (adds ads_management, ads_read)
META_PAGE_ROLES_VIA_BUSINESS_MANAGER=
# Facebook Login for Business configuration id (Business-type app); replaces the scope list when set
META_LOGIN_CONFIG_ID=
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=
PUBLICATION_CREDENTIALS_KEY=
PUBLICATION_CREDENTIALS_KEY_ID=
# Optional, only during a key rotation (previous key kept for reading older secrets).
PUBLICATION_CREDENTIALS_PREVIOUS_KEY=
PUBLICATION_CREDENTIALS_PREVIOUS_KEY_ID=
