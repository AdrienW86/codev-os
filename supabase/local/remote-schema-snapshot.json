  "functions": [
    {
      "acl": [
        "=X/postgres",
        "postgres=X/postgres",
        "anon=X/postgres",
        "authenticated=X/postgres",
        "service_role=X/postgres"
      ],
      "name": "set_updated_at",
      "owner": "postgres",
      "definition": "CREATE OR REPLACE FUNCTION public.set_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public'\nAS $function$\nbegin\n  new.updated_at = now();\n  return new;\nend;\n$function$\n"
    },
    {
      "acl": [
        "=X/postgres",
        "postgres=X/postgres",
        "anon=X/postgres",
        "authenticated=X/postgres",
        "service_role=X/postgres"
      ],
      "name": "prevent_audit_log_mutation",
      "owner": "postgres",
      "definition": "CREATE OR REPLACE FUNCTION public.prevent_audit_log_mutation()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public'\nAS $function$\nbegin\n  raise exception 'audit_logs is append-only';\nend;\n$function$\n"
    }
  ],
