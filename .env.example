# Names only — never commit a value. Server-side variables (no NEXT_PUBLIC_ prefix for any secret).
# Publications OAuth (Lot 4.3 P11-a): see docs/publications-oauth.md.
PUBLICATIONS_OAUTH_BASE_URL=
META_APP_ID=
META_APP_SECRET=
# true only if your role on the client Pages comes from a Business Manager (adds ads_management, ads_read)
META_PAGE_ROLES_VIA_BUSINESS_MANAGER=
# Facebook Login for Business configuration id (Business-type app); replaces the scope list when set
META_LOGIN_CONFIG_ID=
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=
PUBLICATION_CREDENTIALS_KEY=
PUBLICATION_CREDENTIALS_KEY_ID=
# Optional, only during a key rotation (previous key kept for reading older secrets).
PUBLICATION_CREDENTIALS_PREVIOUS_KEY=
PUBLICATION_CREDENTIALS_PREVIOUS_KEY_ID=

# --- CODE-V OS V1 (see docs/setup.md, docs/integrations.md). Public variables are listed in docs/setup.md only.
# Core access
CLERK_SECRET_KEY=
AUTHORIZED_ADMIN_USER_ID=
SUPABASE_SECRET_KEY=
# Scheduler: random secret (32+ chars) sent by Vercel Cron as "Authorization: Bearer <secret>"
CRON_SECRET=
# Assistant AI (optional; without a key the assistant uses its deterministic mode)
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ASSISTANT_OPENAI_MODEL=
ASSISTANT_ANTHROPIC_MODEL=
ASSISTANT_STT_MODEL=
# Search Console (read-only OAuth: webmasters.readonly)
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
# PageSpeed Insights (optional, raises the quota)
PAGESPEED_API_KEY=
# Google Ads (read-only monitoring)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Vercel and GitHub (read-only tokens)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
GITHUB_TOKEN=
# Google Drive (publication media)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Report e-mails (Resend). Sending stays OFF until EMAIL_SENDING_ENABLED=true
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_SENDING_ENABLED=
